{
    "name": "transcriber-speaker",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "npm --prefix apps/web run dev -- --hostname 127.0.0.1",
        "worker": "npm --prefix apps/web run worker",
        "build": "npm --prefix apps/web run build",
        "start": "npm --prefix apps/web run start -- --hostname 127.0.0.1",
        "lint": "npm --prefix apps/web run lint",
        "test": "node --test tests/*.test.mjs",
        "test:integration": "node --test tests/api.integration.mjs",
        "setup": "npm --prefix apps/web install && npm --prefix apps/pages install",
        "build:pages": "npm --prefix apps/pages run build",
        "dev:pages": "npm --prefix apps/pages run dev --",
        "preview:pages": "npm --prefix apps/pages run preview --"
    },
    "engines": {
        "node": ">=24"
    }
}